{
  "name": "tool-impulse",
  "version": "1.1.0",
  "description": "Tool Impulse Engine: Unconscious Perceptual Reflex for Autonomous Agent Tool Retrieval",
  "keywords": [
    "agents",
    "tools",
    "mcp",
    "tool-retrieval",
    "llm",
    "ai-sdk",
    "langchain",
    "reflex",
    "submodular",
    "spreading-activation",
    "quantization"
  ],
  "author": "Avery Intelligence",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "default": "./dist/adapters/ai-sdk.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp.d.ts",
      "default": "./dist/adapters/mcp.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "default": "./dist/adapters/langchain.js"
    },
    "./core/quantization": {
      "types": "./dist/core/quantization.d.ts",
      "default": "./dist/core/quantization.js"
    },
    "./core/topology": {
      "types": "./dist/core/topology.d.ts",
      "default": "./dist/core/topology.js"
    },
    "./core/speculative": {
      "types": "./dist/core/speculative.d.ts",
      "default": "./dist/core/speculative.js"
    }
  },
  "bin": {
    "tool-impulse-proxy": "./bin/tool-impulse-proxy.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx benchmarks/run-suite.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
